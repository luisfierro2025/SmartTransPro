# ============================================================================
# Configuración de la versión web (Control Empresa)
#
# Copiá este archivo como .env y completá los valores.
# IMPORTANTE: .env NUNCA se sube a GitHub (ya está en .gitignore).
# ============================================================================

# --- Supabase (obligatorio para trabajar con datos reales) -------------------
# Supabase > Project Settings > Database > Connection string > URI
#
# Usá la cadena del POOLER (termina en puerto 6543), no la directa (5432):
#   - Supabase cierra conexiones directas que quedan abiertas
#   - Vercel abre varias conexiones a la vez y la directa se agota
#
# Formato: postgresql://postgres.PROYECTO:TU_CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Opcionales -------------------------------------------------------------
# Dejalo en "true" para Supabase. Ponlo en "false" solo para Postgres local.
DATABASE_SSL=true

# Conexiones máximas del grupo. Con el pooler alcanza con pocas.
DATABASE_POOL_MAX=5

# Puerto del servidor de desarrollo (npm run dev:nube)
PORT=3000
